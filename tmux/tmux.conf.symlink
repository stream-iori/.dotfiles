# ========== Basic ========= #
set -g default-terminal "xterm-256color"
# 启用 RGB/TrueColor 支持 (Tmux 3.2+)
set -as terminal-features ",alacritty:RGB"
set -as terminal-features ",xterm-256color:RGB"

# 解决某些 TUI 闪烁和延迟
set -s escape-time 0
set -g focus-events on
set -g aggressive-resize off
set -g allow-passthrough on

# 终端扩展支持 (下划线、颜色等)
set -as terminal-overrides ',*:Smulx=\E[4::%p1%dm'
set -as terminal-overrides ',*:Setulc=\E[58::2::%p1%{65536}%/%d::%p1%{256}%/%{255}%&%d::%p1%{255}%&%d%;m'

set -g display-time 3000
set -g history-limit 10000
set -g base-index 1
set -g pane-base-index 1
set -g mouse on
set -g status-interval 5

set-window-option -g allow-rename off
set-window-option -g automatic-rename on

# easy reload
unbind r
bind C-r source-file ~/.tmux.conf \; display-message "tmux.conf reloaded."

# bind prefix
unbind C-b
set -g prefix C-x
bind C-x send-prefix

bind-key v next-layout
bind-key -T copy-mode-vi v send-keys -X begin-selection

# ========== window =========== #
# create window in current path
unbind c
bind c new-window -c "#{pane_current_path}"

# create session

# clean screen
bind C-l send-keys -R C-l \; clear-history


# fast switch windows conflict with easy motion, sugest using C-x W
#bind Space choose-tree -w
#bind C-a last-window
#bind C-j previous-window
#bind C-k next-window

# ========== pane ========== #
# split window
unbind %
bind - split-window -v -c '#{pane_current_path}'
unbind '"'
bind '\' split-window -h -c '#{pane_current_path}'


# select pane
bind -r h select-pane -L
bind -r j select-pane -D
bind -r k select-pane -U
bind -r l select-pane -R

# resize pane
bind -r K resizep -U 5
bind -r J resizep -D 5
bind -r H resizep -L 5
bind -r L resizep -R 5

# swap panes
bind C-u swap-pane -U

# kill pane/window/session
bind q kill-pane
bind C-q kill-window
bind Q kill-session

# 拦截 Ctrl + d (不带前缀键) 以防误关 Shell
# 如果当前进程是 zsh/bash/sh，则忽略并提示；否则发送 C-d (用于 vim 翻页等)
bind-key -n C-d if-shell "echo '#{pane_current_command}' | grep -iqE '(zsh|bash|sh)'" \
    "display-message \"Ctrl-D intercepted. Type 'exit' and press Enter to close this pane.\"" \
    "send-keys C-d"

# ========== Notifition ========== #
setw -g monitor-activity off
set -g visual-activity off

# ========== Copy Mode ========== #
setw -g mode-keys vi
bind v copy-mode
bind-key -T copy-mode-vi 'v' send -X begin-selection
bind-key -T copy-mode-vi 'y' send-keys -X copy-pipe-and-cancel "pbcopy"
bind-key -T copy-mode-vi 'r' send-keys -X rectangle-toggle
bind -Tcopy-mode-vi Escape send -X cancel

bind -T copy-mode-vi MouseDrag1Pane send -X begin-selection

# ========== Colorscheme (Zellij Style) ========== #
set -g status-justify "left"
set -g status "on"
set -g status-position top
set -g status-left-length "100"
set -g status-right-length "0"
set -g status-bg "colour235"

# 移除右侧信息 (右上角保持空白)
set -g status-right ""

# 左侧 Session 样式
set -g status-left "#[fg=colour232,bg=colour148,bold] #S #[fg=colour148,bg=colour235,nobold] "

# 窗口标签样式 (类 Zellij 箭头)
setw -g window-status-separator ""

# 未激活窗口
setw -g window-status-format "#[fg=colour235,bg=colour239,nobold,nounderscore,noitalics]#[fg=colour250,bg=colour239] #I  #W #[fg=colour239,bg=colour235,nobold,nounderscore,noitalics]"

# 当前激活窗口
setw -g window-status-current-format "#[fg=colour235,bg=colour114,nobold,nounderscore,noitalics]#[fg=colour232,bg=colour114,bold] #I  #W #[fg=colour114,bg=colour235,nobold,nounderscore,noitalics]"

# ========== Plugins (TPM) ========== #
# 【快捷键提示】
# 1. 安装插件：Prefix (Ctrl-x) + I (大写 I)
# 2. 更新插件：Prefix (Ctrl-x) + U (大写 U)
# 3. 清理插件：Prefix (Ctrl-x) + alt + u (小写 u)
#
# --- 会话保存/恢复快捷键 (tmux-resurrect) ---
# * 手动保存当前会话：Prefix (Ctrl-x) + Ctrl-s
# * 手动恢复上次会话：Prefix (Ctrl-x) + Ctrl-r
#
# --- 自动恢复机制 (tmux-continuum) ---
# * 后台每 15 分钟自动保存一次当前所有会话，开机/启动 tmux 时自动执行恢复

# 默认需要引入的插件管理器
set -g @plugin 'tmux-plugins/tpm'
# 自动保存/手动恢复 session 的核心插件
set -g @plugin 'tmux-plugins/tmux-resurrect'
# 自动备份以及开机自动恢复插件
set -g @plugin 'tmux-plugins/tmux-continuum'

# --- tmux-resurrect 配置 ---
# 恢复面板内的内容
set -g @resurrect-capture-pane-contents 'on'
# 恢复额外的程序（默认只恢复一些常用程序，可以自定义添加比如 nvim 等）
set -g @resurrect-processes 'ssh psql mysql sqlite3 mock'

# --- tmux-continuum 配置 ---
# 开启电脑开机或 tmux 服务启动时自动恢复上一次保存的 session
set -g @continuum-restore 'on'
# 自动保存的时间间隔（单位：分钟，默认15分钟）
set -g @continuum-save-interval '15'

# 初始化 TMUX 插件管理器 (这行必须保持在配置文件的最底部)
run '~/.tmux/plugins/tpm/tpm'
