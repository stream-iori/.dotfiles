# -----------------------------------------------------------------------------
# 1. General & Window
# -----------------------------------------------------------------------------
# Ghostty reloads configuration with Cmd+Shift+, (its default key binding).

window-width = 100
window-height = 85
window-padding-x = 10
window-padding-y = 10
window-padding-balance = false
window-save-state = never

# Hide the macOS titlebar completely to maximize terminal screen space.
# The window can still be dragged with Option+drag from a resizable edge.
macos-titlebar-style = hidden
macos-window-buttons = hidden

background-opacity = 0.98
background-blur = true
macos-option-as-alt = true

# -----------------------------------------------------------------------------
# 2. Font & Cursor
# -----------------------------------------------------------------------------
font-family = Maple Mono Normal NL NF CN
font-size = 17
font-thicken = true
font-thicken-strength = 100

# Alacritty's font.offset.y adds vertical cell spacing.
adjust-cell-height = 1

cursor-style = block
cursor-style-blink = false

# Prevent Ghostty's shell integration from replacing the block cursor with a
# thin bar at the command prompt. Other shell integration features stay on.
shell-integration-features = no-cursor

# -----------------------------------------------------------------------------
# 3. Scrolling, Selection & Mouse
# -----------------------------------------------------------------------------
# Ghostty measures scrollback in bytes rather than lines. 10 MB is a practical
# approximation of Alacritty's 10,000-line history and is allocated lazily.
scrollback-limit = 10000000
scrollbar = never
mouse-scroll-multiplier = 3
# Keep the viewport at its current position when a terminal application sends
# an unexpected key event. This also works around older Codex TUI versions
# jumping to the bottom after Cmd+C; output is already excluded as well.
scroll-to-bottom = no-keystroke, no-output
copy-on-select = clipboard
mouse-hide-while-typing = true

# Alacritty configured dim colors equal to normal colors.
faint-opacity = 1

# -----------------------------------------------------------------------------
# 4. Links
# -----------------------------------------------------------------------------
# URLs are recognized and opened with Cmd+Click. Ghostty currently has no
# keyboard hint mode equivalent to Alacritty's Cmd+Shift+U URL picker.
link-url = true

# -----------------------------------------------------------------------------
# 5. Colors (Catppuccin Macchiato, copied exactly from Alacritty)
# -----------------------------------------------------------------------------
background = #24273A
foreground = #CAD3F5

cursor-color = #F4DBD6
cursor-text = #24273A

selection-background = #F4DBD6
selection-foreground = #24273A

palette = 0=#494D64
palette = 1=#ED8796
palette = 2=#A6DA95
palette = 3=#EED49F
palette = 4=#8AADF4
palette = 5=#F5BDE6
palette = 6=#8BD5CA
palette = 7=#B8C0E0

palette = 8=#5B6078
palette = 9=#ED8796
palette = 10=#A6DA95
palette = 11=#EED49F
palette = 12=#8AADF4
palette = 13=#F5BDE6
palette = 14=#8BD5CA
palette = 15=#A5ADCB

palette = 16=#F5A97F
palette = 17=#F4DBD6

# -----------------------------------------------------------------------------
# 6. Keyboard Bindings
# -----------------------------------------------------------------------------
keybind = cmd+n=new_window
keybind = cmd+0=reset_font_size
keybind = cmd+f=start_search
# Copy terminal selections as plain text. This avoids the mixed HTML clipboard
# format changing line breaks in rich-text and Electron applications. Automatic
# copy-on-select above is separate from this binding and may still use mixed.
keybind = cmd+c=copy_to_clipboard:plain
keybind = ctrl+enter=text:\x0d
