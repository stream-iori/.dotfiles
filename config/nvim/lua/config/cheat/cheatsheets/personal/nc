tags: [network]
---

# connect to tcp
nc 192.168.1.2 8080

# connect to tcp with unlimit files
nc 192.168.1.2 8080 < /dev/zero

# port scan
nc -v -v -w3 -z 127.0.0.1 8080-8083

# receive files
nc -l -p 8080 > image.jpg

# send files
nc -N 192.168.1.2 8080 < image.jpg

# tcp listen
nc -l -p 8080

# tcp listen with statitics
nc -l -p 8080 | pv

# like telnet
nc -vz {cursor} 8080
