tags: [resource]
---

# list resources using by host and port
# lsof-host-spec
lsof -i@host:port

# lsof-pid
# list resources using by process
lsof -p pid

#lsof-tcp-list
# list resources using by tcp with port
lsof -i :port

#lsof-tcp-status
# list resources using by network
lsof  -i |  grep  -i ESTABLISHED|LISTEN

#lsof-user-process
# list resources using by user account
lsof  -u user
