# This is Git's per-user configuration file.
[user]
    name = sajia.lxx
    email = sajia.lxx@antgroup.com
[url "git@code.alipay.com:"]
    insteadOf = http://code.alipay.com
[url "git@gitlab.alibaba-inc.com:"]
    insteadOf = http://gitlab.alibaba-inc.com
[url "git@gitlab.alipay-inc.com:"]
    insteadOf = http://gitlab.alipay-inc.com

[core]
    ignoreCase = false
    excludesfile = ~/.gitignore_global
    editor = nvim
[push]
    default = current

[includeIf "gitdir:~/codes/"]
    path = ~/codes/.gitconfig

[include]
    path = ~/.gitconfig_proxy
