# This is Git's per-user configuration file.
[user]
    name = stream.liu
    email = stream.iori97@gmail.com

[core]
    ignoreCase = false
    excludesfile = ~/.gitignore_global
    editor = nvim

[push]
    default = current
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
	upmirror = !git fetch upstream && git checkout main && git reset --hard upstream/master && git push -f origin main

[includeIf "gitdir:/Users/stream/codes/antcodes/"]
    path = /Users/stream/codes/antcodes/.gitconfig

[includeIf "gitdir:/Users/stream/codes/opensource/"]
    path = /Users/stream/codes/opensource/.gitconfig
