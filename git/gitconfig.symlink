# This is Git's per-user configuration file.
[user]
    name = stream.liu
    email = stream.iori97@gmail.com

[core]
    ignoreCase = false
    excludesfile = ~/.gitignore_global
    editor = nvim

[push]
    default = current
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
