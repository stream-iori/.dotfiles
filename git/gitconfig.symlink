# This is Git's per-user configuration file.
[user]
	name = stream
	email = stream.iori97@gmail.com
[core]
    ignoreCase = false
    excludesfile = ~/.gitignore_global
    editor = nvim
[push]
    default = current

[includeIf "gitdir:~/codes/"]
    path = ~/codes/.gitconfig

[include]
    path = ~/.gitconfig_proxy
