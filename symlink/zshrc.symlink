source ~/.zshenv
source ~/.zshprivate
source ${HOMEBREW_PREFIX}/opt/zinit/zinit.zsh

# theme
zinit ice depth=1; zinit light romkatv/powerlevel10k

zinit light zsh-users/zsh-syntax-highlighting
# oh-my-zsh bundle
zinit snippet OMZ::plugins/git
zinit snippet OMZ::plugins/autojump
zinit snippet OMZ::plugins/fzf
zinit snippet OMZ::lib/history.zsh
zinit light Aloxaf/fzf-tab

#
zinit ice lucid wait='0'; zinit light zsh-users/zsh-completions

# 关闭 C-s 的提醒
stty -ixon

# Compilation flags
# export ARCHFLAGS="-arch x86_64"

# ssh
# export SSH_KEY_PATH="~/.ssh/dsa_id"
export EDITOR="nvim"
export IGNOREEOF=2

# --- Aliases ---
alias proxy='export https_proxy=http://127.0.0.1:8118;export http_proxy=http://127.0.0.1:8118'
alias unproxy='unset https_proxy; unset http_proxy'
alias no_proxy='export NO_PROXY=localhost,127.0.0.1,10.96.0.0/12,192.168.99.0/24,192.168.64.0/24'
alias ls='ls --color'
alias ll='ls --color'
alias cat='bat'
alias local-ip="ipconfig getifaddr en0"
alias lgit="lazygit"
alias chrome="open -a \"Google Chrome\" $@"
alias vim="nvim"
alias aria2c="aria2c --conf-path='/Users/stream/.aria2.conf' -D"

# autojump
[ -f ${HOMEBREW_PREFIX}/etc/profile.d/autojump.sh ] && . ${HOMEBREW_PREFIX}/etc/profile.d/autojump.sh

#fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

#cheat search
[ -f $DOTFILES/config/my-zsh/cheat-fzf.sh ] && . $DOTFILES/config/my-zsh/cheat-fzf.sh

[ -f $HOME/.cargo/env ] && source "$HOME/.cargo/env"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
