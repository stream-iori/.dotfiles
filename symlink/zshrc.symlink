source ~/.zshenv
source /usr/local/opt/zinit/zinit.zsh

zinit load zsh-users/zsh-syntax-highlighting

# theme
zinit ice depth=1; zinit light romkatv/powerlevel10k

# oh-my-zsh bundle
zinit snippet OMZ::plugins/git/git.plugin.zsh
zinit snippet OMZ::plugins/autojump/autojump.plugin.zsh
zinit snippet OMZ::plugins/fzf/fzf.plugin.zsh
zinit snippet OMZ::lib/history.zsh
zinit light Aloxaf/fzf-tab

#
zinit ice lucid wait='0'; zinit light zsh-users/zsh-completions

# 关闭 C-s 的提醒
stty -ixon

# Compilation flags
# export ARCHFLAGS="-arch x86_64"

# ssh
# export SSH_KEY_PATH="~/.ssh/dsa_id"

# autojump
[ -f /usr/local/etc/profile.d/autojump.sh ] && . /usr/local/etc/profile.d/autojump.sh

#fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

#cheat search
[ -f $DOTFILES/config/my-zsh/cheat-fzf.sh ] && . $DOTFILES/config/my-zsh/cheat-fzf.sh

eval "$(pyenv init -)"
if which pyenv-virtualenv-init > /dev/null; then eval "$(pyenv virtualenv-init -)"; fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

### MANAGED BY RANCHER DESKTOP START (DO NOT EDIT)
export PATH="/Users/stream/.rd/bin:$PATH"
### MANAGED BY RANCHER DESKTOP END (DO NOT EDIT)
#
export HOMEBREW_NO_AUTO_UPDATE=1

# Wasmer
export WASMER_DIR="/Users/stream/.wasmer"
[ -s "$WASMER_DIR/wasmer.sh" ] && source "$WASMER_DIR/wasmer.sh"
___MY_VMOPTIONS_SHELL_FILE="${HOME}/.jetbrains.vmoptions.sh"; if [ -f "${___MY_VMOPTIONS_SHELL_FILE}" ]; then . "${___MY_VMOPTIONS_SHELL_FILE}"; fi
___MY_VMOPTIONS_SHELL_FILE="${HOME}/.jetbrains.vmoptions.sh"; if [ -f "${___MY_VMOPTIONS_SHELL_FILE}" ]; then . "${___MY_VMOPTIONS_SHELL_FILE}"; fi
___MY_VMOPTIONS_SHELL_FILE="${HOME}/.jetbrains.vmoptions.sh"; if [ -f "${___MY_VMOPTIONS_SHELL_FILE}" ]; then . "${___MY_VMOPTIONS_SHELL_FILE}"; fi
