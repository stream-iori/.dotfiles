# ------------------------------------------------------------------------------
# 1. Base Setup
# ------------------------------------------------------------------------------
source ~/.zshenv
[[ -f ~/.zshprivate ]] && source ~/.zshprivate

# ------------------------------------------------------------------------------
# 2. Zinit Setup (Plugin Manager)
# ------------------------------------------------------------------------------
# Initialize Zinit
ZINIT_HOME="${HOMEBREW_PREFIX}/opt/zinit/zinit.zsh"
[[ -f $ZINIT_HOME ]] && source $ZINIT_HOME

# Powerlevel10k (Instant prompt initialization)
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
zinit ice depth=1; zinit light romkatv/powerlevel10k

# Core Plugins (Async loading)
zinit ice wait'0' lucid; zinit light zsh-users/zsh-completions
zinit ice wait'0' lucid; zinit light zsh-users/zsh-autosuggestions
zinit ice wait'0' lucid; zinit light zdharma-continuum/fast-syntax-highlighting

# fzf-tab (Modern completion interface)
zinit ice wait'0' lucid; zinit light Aloxaf/fzf-tab

# Oh My Zsh snippets
zinit snippet OMZ::plugins/git

# ------------------------------------------------------------------------------
# 3. Aliases & Functions
# ------------------------------------------------------------------------------

# Modern replacements
alias vim="nvim"
alias ls="ls --color"
alias ll="ls --color"
alias lgit="lazygit"

# Network
alias local-ip="ipconfig getifaddr en0"
alias proxy='export http_proxy=http://127.0.0.1:6152; export https_proxy=http://127.0.0.1:6152; export all_proxy=socks5h://127.0.0.1:6153; export ALL_PROXY=socks5h://127.0.0.1:6153'
alias unproxy='unset all_proxy ALL_PROXY http_proxy https_proxy'

# Obsidian Quick-open
unalias ob 2>/dev/null
function ob() {
  [[ -d .obsidian ]] || mkdir .obsidian
  local target_dir=$(pwd)
  local folder_name=${1:-$(basename "$target_dir")}
  local vault_name=$(basename "$OBSIDIAN_MAIN_VAULT")
  local link_dir="$OBSIDIAN_MAIN_VAULT/External"
  mkdir -p "$link_dir"
  ln -shf "$target_dir" "$link_dir/$folder_name"
  local encoded_vault=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$vault_name")
  local encoded_path=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "External/$folder_name")
  echo "Linking $(basename "$target_dir") as '$folder_name' to $vault_name..."
  open "obsidian://open?vault=$encoded_vault&path=$encoded_path"
}

# ------------------------------------------------------------------------------
# 4. Interactive Options
# ------------------------------------------------------------------------------
export IGNOREEOF=2
stty -ixon

# Emacs-style keybindings
bindkey -e
bindkey "^A" beginning-of-line
bindkey "^E" end-of-line

# Completion Styling (Consistent with FZF theme)
zstyle ':completion:*' menu no
zstyle ':completion:*' completer _extensions _complete _approximate
zstyle ':fzf-tab:*' continuous-trigger '/'

# ------------------------------------------------------------------------------
# 5. Integrations (Optimized for speed)
# ------------------------------------------------------------------------------

# Atuin (History)
if (( $+commands[atuin] )); then
  zinit ice wait'0' lucid nocompile atinit'eval "$(atuin init zsh)"'; zinit light zdharma-continuum/null
fi

# Zoxide (Navigation)
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)" # Keep sync for immediate use
  alias zz='__zoxide_zi'
fi

# FZF (Keybindings)
if (( $+commands[fzf] )); then
  eval "$(fzf --zsh)"
fi

# SDKMAN & Cargo (Deferred loading)
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"
[[ -f $HOME/.cargo/env ]] && source "$HOME/.cargo/env"

# Cheat
[[ -f $DOTFILES/config/my-zsh/cheat-fzf.sh ]] && . $DOTFILES/config/my-zsh/cheat-fzf.sh
