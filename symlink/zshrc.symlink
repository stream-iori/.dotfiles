# ------------------------------------------------------------------------------
# 1. Base Setup
# ------------------------------------------------------------------------------
source ~/.zshenv
[[ -f ~/.zshprivate ]] && source ~/.zshprivate

# ------------------------------------------------------------------------------
# 2. Zinit Setup (Plugin Manager)
# ------------------------------------------------------------------------------
ZINIT_HOME="${HOMEBREW_PREFIX}/opt/zinit/zinit.zsh"
[[ -f $ZINIT_HOME ]] && source $ZINIT_HOME

# Powerlevel10k (Instant prompt initialization)
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
zinit ice depth=1; zinit light romkatv/powerlevel10k

# Core Completion Engine (MUST load before compinit)
zinit light zsh-users/zsh-completions

# Completion system initialization
# This must happen AFTER zsh-completions but BEFORE fzf-tab
autoload -Uz compinit && compinit

# fzf-tab (Modern completion interface, MUST load after compinit)
zinit light Aloxaf/fzf-tab

# Other UI Plugins (Can be async)
zinit ice wait'0' lucid; zinit light zsh-users/zsh-autosuggestions
zinit ice wait'0' lucid; zinit light zdharma-continuum/fast-syntax-highlighting

# Oh My Zsh snippets
zinit snippet OMZ::plugins/git

# ------------------------------------------------------------------------------
# 3. Integrations (Optimized for speed)
# ------------------------------------------------------------------------------

# Load Aliases & Functions (Unified management)
[[ -f $DOTFILES/config/my-zsh/aliases.zsh ]] && . $DOTFILES/config/my-zsh/aliases.zsh
[[ -f $DOTFILES/config/my-zsh/functions.zsh ]] && . $DOTFILES/config/my-zsh/functions.zsh

# Atuin (History)
if (( $+commands[atuin] )); then
  zinit ice wait'0' lucid nocompile atinit'eval "$(atuin init zsh)"'; zinit light zdharma-continuum/null
fi

# Zoxide (Navigation)
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# FZF (Keybindings)
if (( $+commands[fzf] )); then
  eval "$(fzf --zsh)"
fi

# Cheat
[[ -f $DOTFILES/config/my-zsh/cheat-fzf.sh ]] && . $DOTFILES/config/my-zsh/cheat-fzf.sh

# ------------------------------------------------------------------------------
# 4. Keybindings & Behavior
# ------------------------------------------------------------------------------

# Restore Emacs-style line editing (Fixes Ctrl+A/E when EDITOR=vi/nvim)
bindkey -e
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line

# Interactive Options
export IGNOREEOF=3
stty -ixon

# Cargo (Deferred loading)
[[ -f $HOME/.cargo/env ]] && source "$HOME/.cargo/env"
