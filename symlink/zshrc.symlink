# ------------------------------------------------------------------------------
# 1. Base Setup
# ------------------------------------------------------------------------------
source ~/.zshenv
[[ -f ~/.zshprivate ]] && source ~/.zshprivate

# ------------------------------------------------------------------------------
# 2. Zinit Setup (Plugin Manager)
# ------------------------------------------------------------------------------
# Initialize Zinit
ZINIT_HOME="${HOMEBREW_PREFIX}/opt/zinit/zinit.zsh"
[[ -f $ZINIT_HOME ]] && source $ZINIT_HOME

# Completion system initialization
autoload -Uz compinit && compinit

# Theme (Powerlevel10k)
zinit ice depth=1; zinit light romkatv/powerlevel10k

# Core Plugins
zinit light zdharma-continuum/fast-syntax-highlighting
zinit light zsh-users/zsh-completions
zinit light Aloxaf/fzf-tab

# Oh My Zsh Plugins
zinit snippet OMZ::plugins/git

# Optimized Plugin Loading
zinit ice lucid wait='0'; zinit light zsh-users/zsh-completions

# ------------------------------------------------------------------------------
# 3. Aliases
# ------------------------------------------------------------------------------
# Modern Tooling Replacements
alias vim="nvim"
alias cat="bat"
alias ls="ls --color"
alias ll="ls --color"
alias lgit="lazygit"

# System & Network
alias local-ip="ipconfig getifaddr en0"
alias proxy='export https_proxy=http://127.0.0.1:8118; export http_proxy=http://127.0.0.1:8118'
alias unproxy='unset https_proxy; unset http_proxy'
alias no_proxy='export NO_PROXY=localhost,127.0.0.1,10.96.0.0/12,192.168.99.0/24,192.168.64.0/24'

# Application Shortcuts
alias chrome="open -a \"Google Chrome\" $@"
alias aria2c="aria2c --conf-path='/Users/stream/.aria2.conf' -D"

# ------------------------------------------------------------------------------
# 4. Interactive Options
# ------------------------------------------------------------------------------
export EDITOR="nvim"
export IGNOREEOF=2 # Exit after 2 consecutive Ctrl-d

# Terminal Options
stty -ixon # Disable C-s terminal locking

# Disable fzf-tab's default continuous trigger which sometimes conflicts
zstyle ':fzf-tab:*' continuous-trigger '/'

# ------------------------------------------------------------------------------
# 5. Third-Party Integrations
# ------------------------------------------------------------------------------

# Atuin (Modern shell history)
if (( $+commands[atuin] )); then
  eval "$(atuin init zsh)"
fi

# Zoxide (Modern replacement for jump-to-directory)
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
  alias zz='__zoxide_zi'
fi

# FZF Initialization
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh

# Cheat (Dotfiles search script)
[[ -f $DOTFILES/config/my-zsh/cheat-fzf.sh ]] && . $DOTFILES/config/my-zsh/cheat-fzf.sh

# Rust (Cargo)
[[ -f $HOME/.cargo/env ]] && source "$HOME/.cargo/env"

# SDKMAN
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# Powerlevel10k Specific Configuration
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
