" IdeaVim mappings shared by IntelliJ IDEA and PyCharm.
" Keep this file aligned with config/nvim/NEOVIM_CHEAT_SHEET.md.

" Search and editor behavior
set history=10000
set hlsearch
set incsearch
set ignorecase
set smartcase
set wrapscan
set nowrap
set scrolloff=4
set sidescrolloff=8
set clipboard=unnamedplus,ideaput

" IdeaVim plugins
set surround
set commentary
set easymotion

let mapleader = " "

" Save in Normal, Visual, and Insert modes
nmap <C-s> <Action>(SaveAll)
xmap <C-s> <Action>(SaveAll)
imap <C-s> <Action>(SaveAll)

" Flash-style two-character jump
map s <Plug>(easymotion-s2)

" Files, buffers, project tree, and search
nmap <leader><space> <Action>(GotoFile)
nmap <leader>ff <Action>(GotoFile)
nmap <leader>fr <Action>(RecentFiles)
nmap <leader>, <Action>(Switcher)
nmap [b <Action>(PreviousEditorTab)
nmap ]b <Action>(NextEditorTab)
nmap <leader>bd <Action>(CloseContent)
nmap <leader>e <Action>(ActivateProjectToolWindow)
nmap <leader>/ <Action>(FindInPath)
nmap <leader>sg <Action>(FindInPath)

" Code navigation and help
nmap gd <Action>(GotoDeclaration)
nmap gr <Action>(FindUsages)
nmap gI <Action>(GotoImplementation)
nmap gy <Action>(GotoTypeDeclaration)
nmap K <Action>(QuickJavaDoc)
nmap gK <Action>(ParameterInfo)

" Code actions and diagnostics
nmap <leader>ca <Action>(ShowIntentionActions)
nmap <leader>cr <Action>(RenameElement)
nmap <leader>co <Action>(OptimizeImports)
nmap <leader>cf <Action>(ReformatCode)
nmap <leader>cd <Action>(ShowErrorDescription)
nmap [d <Action>(GotoPreviousError)
nmap ]d <Action>(GotoNextError)
nmap <leader>xx <Action>(ActivateProblemsViewToolWindow)

" Editor splits
nmap <leader>- <Action>(SplitHorizontally)
nmap <leader><Bar> <Action>(SplitVertically)
nmap <leader>wd <Action>(Unsplit)
nmap <leader>wm <Action>(MaximizeEditorInSplit)

" Git and VCS
nmap <leader>gg <Action>(Vcs.QuickListPopupAction)
nmap <leader>gs <Action>(ActivateCommitToolWindow)
nmap <leader>gf <Action>(Vcs.ShowTabbedFileHistory)
nmap <leader>gb <Action>(Annotate)
nmap [h <Action>(VcsShowPrevChangeMarker)
nmap ]h <Action>(VcsShowNextChangeMarker)

" Tests and run configurations
nmap <leader>tr <Action>(RunClass)
nmap <leader>tl <Action>(Rerun)
nmap <leader>tS <Action>(Stop)
