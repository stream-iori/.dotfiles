
set history=100000
set hlsearch                      " highlight search occurrences
set surround                      " enable vim-surround emulation
set commentary                    " set multiple-cursors
set easymotion
set incsearch
set ignorecase
set ideajoin
set smartcase
set visualbell
set clipboard=unnamedplus,unnamed,ideaput " integrate with system clipboard
set gdefault                      " substitute all occurrences in line per default
set scrolloff=5 sidescrolloff=10  " keep some lines before and after the cursor visible
set wrapscan                      " searches wrap around the end of the file

let mapleader = " "

set keep-english-in-normal "开启输入法自动切换功能
set keep-english-in-normal-and-restore-in-insert "回到insert模式时恢复输入法
set nokeep-english-in-normal-and-restore-in-insert "保留输入法自动切换功能，但是回到insert模式不恢复输入法

noremap \e :e ~/.ideavimrc<CR>
nnoremap \r :action IdeaVim.ReloadVimRc.reload<CR>

" make Y behave like D and C, yanking till end of line
map Y y$

"imap jk <Esc>
"imap kj <Esc>

" don't overwrite register when pasting over selection
vnoremap p pgvy

" clear search highlighting
nnoremap <leader>/ :nohls<CR><ESC>

map <C-s> :action SaveAll<CR>
nnoremap <leader>si :source ~/.ideavimrc<CR>

" High frequency
nmap <C-x>b :action RecentFiles<CR>
nmap <Leader>s <Plug>(easymotion-s2)

" Editor which will change file
map <leader>fm :action ReformatCode<CR>
map <leader>cf :action ReformatCode<CR>
map <leader>lo :action OptimizeImports<CR>
map <A-e> :action EditorCompleteStatement<CR>
map <A-c> :action CommentByBlockComment<CR>
map <C-A-y> :action PasteMultiple<CR>

nnoremap <Leader>es :%s//g<Left><Left>
xnoremap <Leader>es :s//g<Left><Left>
nnoremap <leader>rt :action Refactorings.QuickListPopupAction<CR>

" Editor refactor
nnoremap <leader>re :action RenameElement <CR> <ESC>
nnoremap <leader>: :action GotoAction<CR>

" Create
nmap <leader>cc :action NewClass<CR>
nmap <leader>cg :action Generate<CR>

"Compile and Running
nmap <leader>rr :action ChooseRunConfiguration<CR>
nmap <leader>rs :action Stop<CR>

" Active window
nmap <C-w>q :action CloseContent<CR>
nmap <leader>wp :action ActivateProplemsToolWindow<CR>
nmap <leader>ws :action ActivateStructureToolWindow<CR>
nmap <leader>wd :action ActivateDebugToolWindow<CR>
nmap <leader>wb :action ActivateProjectToolWindow<CR>
nmap <Leader>wh :action HideAllWindows<CR>
nmap <leader>wx :action MoveEditorToOppositeTabGroup<CR>
nmap <leader>wm :action MaximizeEditorInSplit<CR>
nmap <leader>wc :action CallHierarchy<CR>

" Git
nmap <leader>gbl :action Annotate<CR>
nmap <leader>gb :action Git.Branches<CR>
nmap <leader>gh :action Vcs.ShowTabbedFileHistory<CR>
nmap <leader>gc :action CheckinProject<CR>
nmap <leader>ga :action Git.Add<CR>
nmap <leader>gs :action ActivateCommitToolWindow<CR>

" Search
map <leader>f :action SearchEverywhere<CR>
map <leader>fc :action GotoClass<CR>
map <leader>F :action FindInPath<CR>
map <leader>ff :action FindInPath<CR>
map <leader>bl :action RecentFiles<CR>
map <leader>bb :action RecentFiles<CR>

" Codes navigation in multiple files
nnoremap <C-o> :action Back<CR>
nnoremap <C-t> :action Back<CR>
nnoremap <C-i> :action Forward<CR>

" For java or jump in single file
nmap gt :action GotoTypeDeclaration<CR>
nmap gd :action GotoDeclaration<CR>
nmap gr :action ShowUsages<CR>
nmap gi :action GotoImplementation<CR>
nmap gs :action GotoSuperMethod<CR>
nmap ge :action GotoNextError<CR>
nmap gE :action GotoPreviousError<CR>
nmap ggc :action VcsShowNextChangeMarker<CR>
nmap K  :action ParameterInfo<CR>

"locate file in project
nmap gp :action SelectIn<CR><CR>
nmap <leader><leader>e :action SelectIn<CR><CR>

"Tip
nmap <leader>le :e pom.xml<CR>
nmap <leader>bmr :action Maven.Reimport<CR>

