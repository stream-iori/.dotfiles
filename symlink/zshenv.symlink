#!/usr/bin/env zsh

export PATH="/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/sajia/bin"
GNU_BIN=/usr/local/opt/coreutils/libexec/gnubin
GNU_SED_BIN=/usr/local/opt/gnu-sed/libexec/gnubin

export PATH="$GNU_BIN:$GNU_SED_BIN:$PATH"

export JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home

export GOPATH=$HOME/go
export GOBIN=$GOPATH
export GOROOT=/usr/local/opt/go/libexec

export PATH=$PYTHON_PATH:$PATH:$GNU_BIN:$GOROOT/bin:$GOPATH/bin
export MANPATH="/usr/local/opt/coreutils/libexec/gnuman:$MANPATH"

# maven version in my company macbook
export PATH=/usr/local/opt/maven@3.5/bin:$PATH

export DOTFILES=$HOME/.dotfiles
# Add RVM to PATH for scripting. Make sure this is the last PATH variable change.
export PATH="$PATH:$HOME/.rvm/bin"

#jenv
export PATH="$HOME/.jenv/bin:$PATH"
#node17
export PATH="/usr/local/opt/node@17/bin:$PATH"

# You may need to manually set your language environment
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

LC_CTYPE=en_US.UTF-8
LC_ALL=en_US.UTF-8

export TERM=screen-256color
export GO111MODULE=auto
export GOPROXY=https://goproxy.cn,direct
. "$HOME/.cargo/env"
