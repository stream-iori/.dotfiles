#!/usr/bin/env zsh

# ------------------------------------------------------------------------------
# 1. Core Paths & Base Environment
# ------------------------------------------------------------------------------
# Ensure HOMEBREW_PREFIX is set for the current environment
[[ -v HOMEBREW_PREFIX ]] || export HOMEBREW_PREFIX="/opt/homebrew"

# Initialize path array with system defaults
typeset -U path
path=(
  ${HOMEBREW_PREFIX}/bin
  ${HOMEBREW_PREFIX}/sbin
  ${HOMEBREW_PREFIX}/opt/coreutils/libexec/gnubin
  ${HOMEBREW_PREFIX}/opt/gnu-sed/libexec/gnubin
  ${HOMEBREW_PREFIX}/opt/llvm/bin
  ${HOMEBREW_PREFIX}/opt/maven@3.5/bin
  $HOME/.cargo/bin
  $HOME/.foundry/bin
  $HOME/.orbstack/bin
  $HOME/.local/bin
  $HOME/bin
  /usr/local/bin
  /usr/bin
  /bin
  /usr/sbin
  /sbin
)

# ------------------------------------------------------------------------------
# 2. Locale & Encoding
# ------------------------------------------------------------------------------
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"

# Terminal compatibility & colors
export TERM="xterm-256color"
export COLORTERM="truecolor"

# ------------------------------------------------------------------------------
# 3. Dev Toolchains
# ------------------------------------------------------------------------------

# Go
export GOPRIVATE="gitlab.alipay-inc.com,code.alipay.com,rsc.io/private"
export GOPROXY="https://goproxy.cn,direct"

# Manpath for GNU Coreutils
export MANPATH="/usr/local/opt/coreutils/libexec/gnuman:$MANPATH"

# ------------------------------------------------------------------------------
# 4. Tool Environment Variables
# ------------------------------------------------------------------------------
export EDITOR="nvim"
export CHEAT_CONFIG_PATH="~/.dotfiles/config/cheat/conf.yml"
export CHEAT_USE_FZF=true
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK
export LS_COLORS='di=1;32'

# FZF Default Options (Modern UI & Performance)
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --inline-info --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc --color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"
export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git'

# ------------------------------------------------------------------------------
# 5. Obsidian Configuration
# ------------------------------------------------------------------------------
export OBSIDIAN_MAIN_VAULT="$HOME/Documents/Notes"
