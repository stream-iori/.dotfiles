#!/usr/bin/env zsh
[[ -v HOMEBREW_PREFIX ]] || export HOMEBREW_PREFIX="/usr/local"
export PATH="${HOMEBREW_PREFIX}/bin:${HOMEBREW_PREFIX}/sbin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/stream/bin"
GNU_BIN=${HOMEBREW_PREFIX}/opt/coreutils/libexec/gnubin
GNU_SED_BIN=${HOMEBREW_PREFIX}/opt/gnu-sed/libexec/gnubin
LLVM_BIN=${HOMEBREW_PREFIX}/opt/llvm/bin

LDFLAGS="-L/usr/local/opt/llvm/lib/c++ -Wl,-rpath,/usr/local/opt/llvm/lib/c++"

#GO
export GOPATH=$HOME/go
export GOBIN=$GOPATH

export C_INCLUDE_PATH=/usr/local/include
export LIBRARY_PATH=/usr/local/lib
export CPLUS_INCLUDE_PATH=/usr/local/include:$CPLUS_INCLUDE_PATH

export JDK_INCLUDE="/Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home/include;/Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home/include/darwin"
export JLI_SO="/Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home/jre/lib/jli"

export LDFLAGS="-L/usr/local/opt/llvm/lib"
export CPPFLAGS="-I/usr/local/opt/llvm/include"


# JDK
export JAVA_8="/Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home"
export JAVA_17="/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home"
export JAVA_21="/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home"
export GRAAL_JAVA_8="/Library/Java/JavaVirtualMachines/graalvm-ce-lts-java8-20.3.1/Contents/Home"

alias j8='export JAVA_HOME=$JAVA_8'
alias j17='export JAVA_HOME=$JAVA_17'
alias j21='export JAVA_HOME=$JAVA_21'
alias g8='export JAVA_HOME=$GRAAL_JAVA_8'
export JAVA_HOME=$JAVA_8

export PYENV_ROOT="$HOME/.pyenv"
export CHEAT_CONFIG_PATH="~/.dotfiles/config/cheat/conf.yml"
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK

export PATH=$GNU_BIN:$GNU_SED_BIN:$LLVM_BIN:$PYENV_ROOT/shims:$PATH:$GNU_BIN:$GOROOT/bin:$GOBIN:$PATH
export MANPATH="/usr/local/opt/coreutils/libexec/gnuman:$MANPATH"

# maven version in my company macbook
export PATH=/usr/local/opt/maven@3.5/bin:$PATH

export DOTFILES=$HOME/.dotfiles
# Add RVM to PATH for scripting. Make sure this is the last PATH variable change.
export PATH="$PATH:$HOME/.rvm/bin"

# JDK
export JAVA_8="/Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home"
export JAVA_17="/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home"
export JAVA_21="/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home"
export GRAALVM_17="/Library/Java/JavaVirtualMachines/graalvm-ce-java17/Contents/Home"

alias j8='export JAVA_HOME=$JAVA_8'
alias j17='export JAVA_HOME=$JAVA_17'
alias g17='export JAVA_HOME=$GRAALVM_17'

export JAVA_HOME=$JAVA_8


# You may need to manually set your language environment
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

LC_CTYPE=en_US.UTF-8
LC_ALL=en_US.UTF-8

export TERM=screen-256color

export GOPRIVATE=gitlab.alipay-inc.com,code.alipay.com,rsc.io/private
export GOPROXY=https://goproxy.cn,direct
#. "$HOME/.cargo/env"

export CHEAT_USE_FZF=true

# fzf 配合FD使用
export FZF_DEFAULT_COMMAND='fd --type f --color=never'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type d --color=never"

# User configuration
alias proxy='export https_proxy=http://127.0.0.1:8118;export http_proxy=http://127.0.0.1:8118'
alias unproxy='unset https_proxy; unset http_proxy'
alias no_proxy='export NO_PROXY=localhost,127.0.0.1,10.96.0.0/12,192.168.99.0/24,192.168.64.0/24'
#
alias ls='ls --color'
alias ll='ls --color'

#alias kc="kubectl"
alias local-ip="ipconfig getifaddr en0"
alias lgit="lazygit"

alias chrome="open -a \"Google Chrome\" $@"
alias vim="nvim"
alias aria2c="aria2c --conf-path='/Users/stream/.aria2.conf' -D"

alias mvn="mvn"

# ---- Eza (better ls) -----
alias ls="eza --color=always --git --icons=always --no-user --no-permissions --sort newest"


loginName=`id -un`

